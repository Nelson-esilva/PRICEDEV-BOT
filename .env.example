# Copie para .env na máquina. NÃO commite .env, sessão Telegram, cookie ML nem o banco.
# No servidor, deixe o .env fora do git (já ignorado) e a sessão no volume Docker.
# Opcional no servidor: arquivo extra só com contas, fora do checkout
# PRICEDEV_SECRETS_FILE=/etc/pricedev/.env

APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./pricedev.db
LOG_LEVEL=INFO
PRICEDEV_DATA_DIR=./data

ENABLE_SCHEDULER=true

ENABLE_PELANDO=false
ENABLE_SHOPEE=true
ENABLE_MERCADOLIVRE=true
ENABLE_MAGALU=true
ENABLE_KABUM=false
ENABLE_LOMADEE=false
ENABLE_PRICE_CONFIRM=true
ENABLE_WATCHLIST=true
ENABLE_TELEGRAM_PUBLISH=true
ENABLE_CHANNEL_INBOX=true
ENABLE_ML_HUB=true

# Contas Telegram — preencher no .env local (nunca no git)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./telegram_inbox.session
TELEGRAM_INBOX_CHATS=
TELEGRAM_INBOX_BLOCK_CHATS=PROMODEV
TELEGRAM_INBOX_BACKFILL=40
TELEGRAM_DEDUP_HOURS=3

WATCHLIST_POLL_SECONDS=30

PELANDO_POLL_SECONDS=15
PELANDO_FEED_PAGES=4
PELANDO_DEAL_DETAILS_PER_POLL=20
PELANDO_BASE_URL=https://api-web.pelando.com.br
PELANDO_USER_AGENT=PriceDevBot/0.1 (+local-dev)

SHOPEE_POLL_SECONDS=60
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_MAX_ITEMS=400
SHOPEE_PAGES_PER_LIST=4
SHOPEE_PAGE_SIZE=50
SHOPEE_KEYWORDS=ssd,air fryer,monitor gamer,fone bluetooth,smartwatch
# Buscas por palavra-chave entram na coleta, ordenadas por vendas (vazio desliga).
# Filtro de qualidade na coleta: mínimo de vendas e nota (0 desliga).
SHOPEE_MIN_SALES=50
SHOPEE_MIN_RATING=4.5
# subIds dos short links (até 5, alfanuméricos); aparecem no relatório de conversões.
SHOPEE_SUB_IDS=pricedev
# Relatório de conversões → pedidos reais no ranking da vitrine.
ENABLE_SHOPEE_CONVERSIONS=true
SHOPEE_CONVERSIONS_POLL_SECONDS=1800
SHOPEE_CONVERSIONS_DAYS=30
DISCOVERY_KEYWORDS=ssd,air fryer,monitor gamer,fone bluetooth,notebook

MERCADOLIVRE_POLL_SECONDS=45
MAGALU_POLL_SECONDS=180
KABUM_POLL_SECONDS=90
KABUM_KEYWORDS_PER_POLL=8
LOMADEE_POLL_SECONDS=180
PRICE_CONFIRM_PER_POLL=8

LOMADEE_APP_TOKEN=
LOMADEE_SOURCE_ID=

# Afiliados — só no .env local/servidor
ML_AFFILIATE_MATT_WORD=
ML_AFFILIATE_MATT_TOOL=
ML_AFFILIATE_COOKIE=
# Banners de campanha da home do ML viram campanhas na vitrine (só campanhas do próprio ML, nunca anúncios pagos).
ENABLE_ML_HOME_CAMPAIGNS=true
AMAZON_AFFILIATE_TAG=
# Promoções dos grupos (inbox) no site para lojas sem API: só mensagens com o NOSSO link de afiliado.
# KaBuM tem preço/estoque conferidos na página oficial; Amazon usa o preço da postagem (validade curta).
ENABLE_COMMUNITY_DEALS=true
COMMUNITY_STORES=amazon,kabum
COMMUNITY_TTL_HOURS=12
COMMUNITY_POLL_SECONDS=300
# Awin: conta aprovada no programa KaBuM!; token somente no servidor.
ENABLE_AWIN=false
AWIN_PUBLISHER_ID=
AWIN_API_TOKEN=
AWIN_KABUM_ADVERTISER_ID=
# Feed preservado para uso futuro; importação do catálogo desativada no scheduler.
AWIN_KABUM_FEED_URL=
# Consulta atualização a cada 15 minutos; importa até 250 linhas por ciclo de 60s.
AWIN_KABUM_FEED_CHECK_SECONDS=900
AWIN_KABUM_FEED_POLL_SECONDS=60
AWIN_KABUM_FEED_BATCH=250
ML_HUB_POLL_SECONDS=120
ML_HUB_MAX_ITEMS=1200
ML_HUB_PAGES_PER_QUERY=8

# API oficial do Mercado Livre (developers.mercadolivre.com.br/devcenter): mais vendidos por categoria.
# Crie a aplicação (Authorization Code + Refresh Token, negócio "Mercado Livre", sem tópicos),
# preencha ID/secret/redirect e rode: cd backend && ../.venv/bin/python scripts/ml_oauth.py TG-<code>
ENABLE_ML_OFFICIAL=true
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://www.google.com
ML_REFRESH_TOKEN=
ML_OFFICIAL_POLL_SECONDS=1800
ML_OFFICIAL_PER_CATEGORY=20
# ML_OFFICIAL_CATEGORIES=MLB1051,MLB1648,...
# Termos que viram páginas de ranking no site (/ranking/<categoria>): "monitor" -> Monitores.
# ML_RANKING_TERMS=monitor,notebook,smartphone,air fryer,...
# Termos mais buscados do ML (não aparecem no site): quantos viram busca de ofertas no ML e na Shopee.
ML_TREND_SEARCH_TERMS=10
SHOPEE_TREND_KEYWORDS=8
# Fotos oficiais, frete grátis, categoria oficial e posição no ranking das ofertas ML.
ML_ENRICH_BATCH=120
ML_ENRICH_POLL_SECONDS=600
ML_ENRICH_REFRESH_HOURS=12

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PUBLISH_CHAT=PROMODEV
TELEGRAM_PUBLISH_PER_POLL=4

# Dashboard ops / vitrine pública
OPS_API_TOKEN=
PUBLIC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080
STOREFRONT_PUBLISH_SECONDS=120
STOREFRONT_DEAL_TTL_HOURS=36
STOREFRONT_RETENTION_DAYS=14
CLICK_LOG_RETENTION_DAYS=90
STOREFRONT_MIN_SCORE=0
# URL pública do site. Preenchida, os links do Telegram passam por <url>/go/t/... e os cliques são medidos.
# Vazia, o Telegram continua com o link direto da loja.
PUBLIC_SITE_URL=
# Link do grupo/canal no Telegram (ex.: https://t.me/seucanal): botões "Entrar no grupo" do site.
PUBLIC_TELEGRAM_URL=

MIN_HISTORICAL_DISCOUNT_PCT=20
MIN_ACCEPTANCE_SCORE=75
ANOMALY_DISCOUNT_PCT=50

HISTORY_WINDOW_DAYS=90
PROMO_RETENTION_DAYS=5
MIN_HISTORY_OBSERVATIONS=10
MIN_HISTORY_DISTINCT_DAYS=14

ALLOW_PROVISIONAL_OPPORTUNITIES=true
ALLOW_PROVISIONAL_AUTO_PUBLISH=false
REQUIRE_VERIFIED_PRICE_FOR_HISTORICAL_ALERT=true

SCORE_WEIGHT_HISTORICAL_DISCOUNT=30
SCORE_WEIGHT_HISTORY_QUALITY=20
SCORE_WEIGHT_IDENTITY=15
SCORE_WEIGHT_PRICE_VERIFIED=15
SCORE_WEIGHT_FRESHNESS=10
SCORE_WEIGHT_COMMUNITY=10
