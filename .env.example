# Copie para .env na máquina. NÃO commite .env, sessão Telegram, cookie ML nem o banco.
# No servidor, deixe o .env fora do git (já ignorado) e a sessão no volume Docker.

APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./pricedev.db
LOG_LEVEL=INFO
PRICEDEV_DATA_DIR=./data
# Opcional no servidor: arquivo extra só com contas, fora do checkout
# PRICEDEV_SECRETS_FILE=/etc/pricedev/.env

ENABLE_SCHEDULER=true

ENABLE_PELANDO=false
ENABLE_SHOPEE=false
ENABLE_MERCADOLIVRE=true
ENABLE_MAGALU=true
ENABLE_KABUM=true
ENABLE_LOMADEE=false
ENABLE_PRICE_CONFIRM=true
ENABLE_WATCHLIST=true
ENABLE_TELEGRAM_PUBLISH=false
ENABLE_CHANNEL_INBOX=false
ENABLE_ML_HUB=true

PELANDO_POLL_SECONDS=15
PELANDO_FEED_PAGES=4
PELANDO_DEAL_DETAILS_PER_POLL=20
PELANDO_BASE_URL=https://api-web.pelando.com.br
PELANDO_USER_AGENT=PriceDevBot/0.1 (+local-dev)

SHOPEE_POLL_SECONDS=120
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_KEYWORDS=ssd,air fryer,monitor gamer,fone bluetooth,smartwatch
DISCOVERY_KEYWORDS=ssd,air fryer,monitor gamer,fone bluetooth,notebook

MERCADOLIVRE_POLL_SECONDS=45
MAGALU_POLL_SECONDS=180
KABUM_POLL_SECONDS=90
KABUM_KEYWORDS_PER_POLL=8
LOMADEE_POLL_SECONDS=180
PRICE_CONFIRM_PER_POLL=8
WATCHLIST_POLL_SECONDS=30

LOMADEE_APP_TOKEN=
LOMADEE_SOURCE_ID=

# Contas — só no .env local/servidor, nunca no código
ML_AFFILIATE_MATT_WORD=
ML_AFFILIATE_MATT_TOOL=
ML_AFFILIATE_COOKIE=
AMAZON_AFFILIATE_TAG=
ML_HUB_POLL_SECONDS=120

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PUBLISH_CHAT=
TELEGRAM_PUBLISH_PER_POLL=4
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./telegram_inbox.session
TELEGRAM_INBOX_CHATS=
TELEGRAM_INBOX_BACKFILL=40

MIN_HISTORICAL_DISCOUNT_PCT=20
MIN_ACCEPTANCE_SCORE=75
ANOMALY_DISCOUNT_PCT=50

HISTORY_WINDOW_DAYS=90
MIN_HISTORY_OBSERVATIONS=10
MIN_HISTORY_DISTINCT_DAYS=14

ALLOW_PROVISIONAL_OPPORTUNITIES=true
ALLOW_PROVISIONAL_AUTO_PUBLISH=false
REQUIRE_VERIFIED_PRICE_FOR_HISTORICAL_ALERT=true

SCORE_WEIGHT_HISTORICAL_DISCOUNT=30
SCORE_WEIGHT_HISTORY_QUALITY=20
SCORE_WEIGHT_IDENTITY=15
SCORE_WEIGHT_PRICE_VERIFIED=15
SCORE_WEIGHT_FRESHNESS=10
SCORE_WEIGHT_COMMUNITY=10
